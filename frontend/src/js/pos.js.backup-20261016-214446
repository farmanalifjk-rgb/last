async function openPaymentModal() {
  const cart = getActiveCart();

  if (!cart || !cart.items.length) {
    showNotification("Add products to the cart first", "error");

    return;
  }

  if (isCartLocked(cart)) {
    guardCartEditable(cart);

    return;
  }

  const discountCheck = parseDiscount(cart.discount);

  if (canDiscount() && !discountCheck.ok) {
    showNotification(discountCheck.message, "error");

    return;
  }

  /*
   * Always get the authoritative
   * backend total before payment.
   */
  const preview = await previewCurrentCart();

  if (!preview) {
    return;
  }

  const total = parseFloat(preview.total || 0);

  /*
   * FBR-integrated tills must record the buyer above the threshold
   * (S.R.O. 1006(I)/2021). Ask before taking payment; checkout enforces it.
   */
  if (preview.buyer_identification_required && !getCustomerId(cart)) {
    const threshold = preview.buyer_identification_threshold;
    showNotification(
      `Sales above ${threshold ? formatCurrency(threshold) : "the FBR limit"} need the buyer's name. Assign a customer first.`,
      "error",
    );

    return;
  }

  const modal = document.getElementById("payment-modal");

  if (!modal) {
    return;
  }

  setPaymentQuote(cart, preview);

  const amountReceivedEl = document.getElementById("amount-received");

  if (amountReceivedEl) {
    amountReceivedEl.value = total.toFixed(2);
  }

  calculateChange();

  modal.classList.add("flex");
  modal.classList.remove("hidden");

  refreshIcons();
}

/** Remember (and display) the total the cashier is about to collect. */
function setPaymentQuote(cart, preview) {
  paymentQuote = {
    cartId: cart.id,
    total: parseFloat(preview.total || 0),
    discount: parseFloat(preview.discount || 0),
  };

  const paymentTotalEl = document.getElementById("payment-total");

  if (paymentTotalEl) {
    paymentTotalEl.innerText = formatCurrency(paymentQuote.total);
  }

  calculateChange();
}

function closePaymentModal() {
  const modal = document.getElementById("payment-modal");

  paymentQuote = null;

  if (!modal) {
    return;
  }

  modal.classList.add("hidden");
  modal.classList.remove("flex");
}

function calculateChange() {
  const receivedEl = document.getElementById("amount-received");

  const changeEl = document.getElementById("change-amount");

  if (!receivedEl || !changeEl) {
    return;
  }

  // The quoted total, never the text of the totals panel.
  const total = paymentQuote ? paymentQuote.total : parseFloat(getActiveCart()?.preview?.total || 0);

  changeEl.innerText = formatCurrency(computeChange(total, receivedEl.value));
}

async function confirmPayment(event) {
  /*
   * Block double clicks while a checkout request is in flight. The cart's
   * Idempotency-Key is still the server-side guarantee: a retried request
   * after a network failure replays the original sale instead of creating
   * a second one.
   */
  if (checkoutInFlight) {
    return;
  }

  const paymentMethodEl = document.getElementById("payment-method-modal");

  const amountReceivedEl = document.getElementById("amount-received");

  const paymentMethod = paymentMethodEl?.value || "cash";

  const amountReceived = parseFloat(amountReceivedEl?.value) || 0;

  const button = event?.currentTarget instanceof HTMLButtonElement ? event.currentTarget : null;

  checkoutInFlight = true;

  if (button) {
    button.disabled = true;
  }

  try {
    await checkout(paymentMethod, amountReceived);
  } finally {
    checkoutInFlight = false;

    if (button) {
      button.disabled = false;
    }
  }
}

