/* =========================================================
   RECEIPT (popup-safe) + LAST RECEIPT
========================================================= */

const LAST_RECEIPT_KEY = "pos-last-receipt";

function receiptUrl(orderId) {
  return `/receipt.html?type=sale&id=${encodeURIComponent(Number(orderId))}`;
}

function rememberLastReceipt(orderId, number) {
  const entry = { orderId: Number(orderId), number: String(number || ""), tenantId: getCachedTenant()?.id ?? null };
  try {
    sessionStorage.setItem(LAST_RECEIPT_KEY, JSON.stringify(entry));
  } catch {
    // Storage unavailable: the button still works for this page view.
  }
  lastReceipt = entry;
  updateLastReceiptButton();
}

let lastReceipt = null;

function loadLastReceipt() {
  try {
    const stored = JSON.parse(sessionStorage.getItem(LAST_RECEIPT_KEY) || "null");
    // Never offer another business's receipt after a switch.
    lastReceipt = stored && stored.orderId && stored.tenantId === (getCachedTenant()?.id ?? null) ? stored : null;
  } catch {
    lastReceipt = null;
  }
  updateLastReceiptButton();
}

function updateLastReceiptButton() {
  const button = document.getElementById("pos-last-receipt");
  if (!button) return;
  button.disabled = !lastReceipt;
  button.title = lastReceipt ? `Reopen receipt ${lastReceipt.number || `#${lastReceipt.orderId}`}` : "No receipt yet in this session";
}

/** Print a sale's receipt without leaving the till (hidden frame). */
function printReceipt(orderId, number = "") {
  rememberLastReceipt(orderId, number);
  printReceiptInFrame(orderId);
}

function reopenLastReceipt() {
  if (!lastReceipt) {
    showNotification("No receipt yet in this session.", "error");
    return;
  }
  // The receipt page records the print; copies after the first print as reprints.
  printReceiptInFrame(lastReceipt.orderId);
  showNotification("Reprinting the last receiptâ€¦", "success");
}

/** Print the receipt page inside a hidden same-origin frame (it prints itself on load). */
function printReceiptInFrame(orderId) {
  document.getElementById("pos-receipt-frame")?.remove();
  const frame = document.createElement("iframe");
  frame.id = "pos-receipt-frame";
  frame.title = "Receipt";
  frame.setAttribute("aria-hidden", "true");
  frame.style.cssText = "position:fixed;right:0;bottom:0;width:0;height:0;border:0;visibility:hidden";
  frame.src = receiptUrl(orderId);
  document.body.appendChild(frame);
  setTimeout(() => frame.remove(), 120000);
}

/*
 * The receipt page (receipt.js) posts {type: "pos-receipt", status, message}
 * to its parent. Only messages from our own frame and origin are trusted.
 */
function handleReceiptFrameMessage(event) {
  const frame = document.getElementById("pos-receipt-frame");
  if (event?.origin !== window.location.origin) return;
  if (!frame || event.source !== frame.contentWindow) return;
  const data = event.data || {};
  if (data.type !== "pos-receipt" || data.status !== "error") return;
  showNotification(`Receipt could not be printed: ${String(data.message || "unknown error")}`, "error");
  showReceiptFallback(lastReceipt, { title: "Receipt could not be printed" });
}

let receiptMessagesBound = false;
function bindReceiptFrameMessages() {
  if (receiptMessagesBound) return;
  receiptMessagesBound = true;
  globalThis.window?.addEventListener?.("message", handleReceiptFrameMessage);
}

function showReceiptFallback(entry, { title = "Receipt could not be printed" } = {}) {
  if (!entry) return;
  const label = entry.number ? `receipt ${escapeHtml(entry.number)}` : "the receipt";
  openModal({
    title,
    hideSubmit: true,
    html: `
      <p class="text-sm text-slate-600">The sale is saved. ${label.charAt(0).toUpperCase() + label.slice(1)} could not be printed automatically.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="${escapeHtml(receiptUrl(entry.orderId))}" target="_blank" data-receipt-open
           class="inline-flex h-11 items-center rounded-xl bg-slate-900 px-5 text-sm font-semibold text-white hover:bg-slate-800">Open receipt</a>
        <button type="button" data-receipt-print
           class="h-11 rounded-xl border border-slate-200 px-5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Print here</button>
      </div>
      <p class="mt-4 text-xs text-slate-500">You can reprint it any time with â€œLast receiptâ€.</p>`,
  });
  const root = document.getElementById("ui-modal-root");
  root?.querySelector("[data-receipt-print]")?.addEventListener("click", () => {
    printReceiptInFrame(entry.orderId);
    showNotification("Preparing the receipt for printingâ€¦", "success");
  });
}

/*
 * Tell the cashier the FBR outcome of the sale just completed. The sale itself
 * is saved whatever happens here; anything but a genuine acceptance is shown as
 * a warning so a non-fiscalized receipt is never mistaken for an FBR invoice.
 */
const FISCAL_CASHIER_MESSAGES = {
  pending: "FBR pending - not yet fiscalized",
  // Cashiers usually cannot open the Fiscal screens: tell them who acts.
  unknown: "FBR outcome unknown - tell your manager (it must be checked before any resend)",
  failed: "FBR not reached yet - tell your manager (it can be resent)",
  rejected: "Rejected by FBR",
  not_submitted: "Not sent to FBR",
  not_fiscalized: "Not sent to FBR",
  simulated: "SIMULATED only - NOT fiscalized by FBR",
};

function notifyFiscalStatus(fiscal) {
  if (!fiscal || !fiscal.status || fiscal.status === "not_configured") {
    return;
  }
  if (fiscal.status === "accepted" && fiscal.fbr_invoice_number) {
    showNotification(`Sale completed - FBR invoice ${fiscal.fbr_invoice_number}`, "success");
    return;
  }
  const base = FISCAL_CASHIER_MESSAGES[fiscal.status] || "Not fiscalized by FBR";
  const detail = fiscal.message ? `: ${String(fiscal.message).slice(0, 160)}` : "";
  showNotification(`Sale saved. ${base}${detail}`, "error");
}

