      return `
        <button type="button" data-select-customer-id="${escapeHtml(id)}"
          class="mb-2 flex w-full items-center gap-3 rounded-xl border border-slate-200 p-3 text-left transition hover:border-lime-400 hover:bg-lime-50 focus:outline-none focus:ring-2 focus:ring-lime-400">
