/*
 * Creates the customer through the canonical customers API
 * (POST /api/customers/, RBAC customers.create - part of the Cashier
 * template). Name is required; the backend rejects a phone/email already
 * used in this business. The new customer is assigned to the active order.
 */
async function createCustomer() {
  if (creatingCustomer) return;
  const name = document.getElementById("customer-name")?.value.trim() || "";
  const phone = document.getElementById("customer-phone")?.value.trim() || "";
  if (!name) {
    setCustomerError("Enter the customer's name.");
    document.getElementById("customer-name")?.focus();
    return;
  }

  const button = document.getElementById("customer-save");
  creatingCustomer = true;
  if (button) {
    button.disabled = true;
    button.setAttribute("aria-busy", "true");
  }
  setCustomerError("");
  try {
    const created = await apiJson("/api/customers/", {
      method: "POST",
      // phone/email are required-but-blankable on this serializer (per-tenant
      // unique constraints), so always send both, blank when not captured.
      body: JSON.stringify({ name, phone: phone || "", email: "" }),
    });
    rememberCustomers([created]);
    closeCustomerModal();
    showNotification(`Customer ${created.name} added`, "success");
    await assignCustomer(String(created.id));
  } catch (error) {
    // apiError already folds field errors (e.g. duplicate phone) into the message.
    setCustomerError(error?.message || "The customer could not be saved.");
  } finally {
    creatingCustomer = false;
    if (button) {
      button.disabled = false;
      button.removeAttribute("aria-busy");
    }
  }
}

