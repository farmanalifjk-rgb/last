const customerDirectory = new Map(); // id (string) -> { id, name, phone, ... }
let customerResults = [];
let customerActiveIndex = -1;
let customerSearchSeq = 0;
let customerSearchTimer = null;
let creatingCustomer = false;

function rememberCustomers(list) {
  list.forEach((customer) => customerDirectory.set(String(customer.id), customer));
}

/** Server-side search: name, phone, email or customer code (max 50 rows). */
async function fetchCustomers(term = "") {
  const query = term ? `?search=${encodeURIComponent(term)}` : "";
  const data = await apiJson(`/api/pos/customers/${query}`);
  const list = Array.isArray(data) ? data : data.results || [];
  rememberCustomers(list);
  return list;
}

async function loadCustomers() {
  wireCustomerPicker();
  try {
    await fetchCustomers("");
  } catch (error) {
    // The picker reports search failures when it is used.
    console.error("LOAD CUSTOMERS ERROR:", error);
  }
  updateCustomerDropdown();
}

function wireCustomerPicker() {
  const input = document.getElementById("customer-search");
  const picker = document.getElementById("customer-picker");
  if (!input || !picker || input.dataset.wired) return;
  input.dataset.wired = "1";

  input.addEventListener("input", () => {
    clearTimeout(customerSearchTimer);
    customerSearchTimer = setTimeout(() => runCustomerSearch(input.value.trim()), 250);
  });
  input.addEventListener("focus", () => runCustomerSearch(input.value.trim()));
  input.addEventListener("keydown", (event) => {
    const results = document.getElementById("customer-results");
    const open = results && !results.classList.contains("hidden");
    if (event.key === "Escape") {
      closeCustomerResults();
      return;
    }
    if (!open) {
      if (event.key === "ArrowDown") runCustomerSearch(input.value.trim());
      return;
    }
    const options = results.querySelectorAll("[data-customer-option]");
    if (["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) {
      event.preventDefault();
      customerActiveIndex = moveActive(customerActiveIndex, options.length, event.key);
      highlightCustomerOption(options);
    } else if (event.key === "Enter") {
      event.preventDefault();
      const active = options[customerActiveIndex] || options[0];
      if (active) chooseCustomerOption(active);
    }
  });

  document.getElementById("customer-results")?.addEventListener("mousedown", (event) => {
    // mousedown (not click) so the input's blur does not close the list first.
    const option = event.target.closest("[data-customer-option]");
    if (!option) return;
    event.preventDefault();
    chooseCustomerOption(option);
  });
  input.addEventListener("blur", () => setTimeout(closeCustomerResults, 150));
  document.getElementById("customer-clear")?.addEventListener("click", () => assignCustomer(null));
}

function chooseCustomerOption(option) {
  if (option.dataset.action === "add") {
    closeCustomerResults();
    showCustomerModal(option.dataset.term || "");
    return;
  }
  assignCustomer(option.dataset.customerId || null);
}

async function runCustomerSearch(term) {
  const mine = ++customerSearchSeq;
  const results = document.getElementById("customer-results");
  if (!results) return;
  openCustomerResults(`<p class="px-3 py-2 text-sm text-slate-500">Searchingâ€¦</p>`);
  try {
    const list = await fetchCustomers(term);
    if (mine !== customerSearchSeq) return;
    customerResults = list;
    renderCustomerResults(term);
  } catch (error) {
    if (mine !== customerSearchSeq) return;
    openCustomerResults(`<p class="px-3 py-2 text-sm text-red-600">${escapeHtml(error?.message || "Customer search failed.")}</p>`);
  }
}

function renderCustomerResults(term) {
  const currentId = getCustomerId(getActiveCart());
  let index = 0;
  const option = (id, label, extra = "") => `
    <button type="button" role="option" id="customer-option-${index++}" data-customer-option data-customer-id="${escapeHtml(id)}" ${extra}
      aria-selected="${String(String(currentId || "") === String(id))}"
      class="w-full rounded-lg px-3 py-2 text-left text-sm hover:bg-slate-100">${label}</button>`;
  let html = option("", `<span class="font-semibold">Walk-in customer</span>`);
  html += customerResults
    .map((customer) => option(customer.id, `<span class="font-medium text-slate-900">${escapeHtml(customer.name)}</span>${customer.phone ? ` <span class="text-slate-500">Â· ${escapeHtml(customer.phone)}</span>` : ""}${customer.customer_code ? ` <span class="text-xs text-slate-400">${escapeHtml(customer.customer_code)}</span>` : ""}`))
    .join("");
  if (term && !customerResults.length) {
    html += `<p class="px-3 py-2 text-sm text-slate-500">No customer matches â€œ${escapeHtml(term)}â€.</p>`;
  }
  if (customerResults.length >= CUSTOMER_RESULT_LIMIT) {
    html += `<p class="px-3 py-2 text-xs text-slate-400">Showing the first ${CUSTOMER_RESULT_LIMIT}. Type more to narrow the search.</p>`;
  }
  html += `<button type="button" role="option" id="customer-option-add" data-customer-option data-action="add" data-term="${escapeHtml(term)}"
      class="mt-1 w-full rounded-lg border-t border-slate-100 px-3 py-2 text-left text-sm font-semibold text-lime-700 hover:bg-lime-50">
      + Add ${term ? `â€œ${escapeHtml(term)}â€` : "a new customer"}</button>`;
  customerActiveIndex = -1;
  openCustomerResults(html);
}

function openCustomerResults(html) {
  const results = document.getElementById("customer-results");
  const input = document.getElementById("customer-search");
  if (!results) return;
