}

function highlightCustomerOption(options) {
  options.forEach((element, index) => {
    const active = index === customerActiveIndex;
    element.classList.toggle("bg-slate-100", active);
    if (active) {
      element.scrollIntoView({ block: "nearest" });
      document.getElementById("customer-search")?.setAttribute("aria-activedescendant", element.id || "");
    }
  });
}

async function assignCustomer(customerId = null) {
  const cart = getActiveCart();

  closeCustomerResults();
  const input = document.getElementById("customer-search");
  if (input) input.value = "";

  if (!cart) {
    showNotification("Create or select an order first.", "error");
    return;
  }

  if (!guardCartEditable(cart)) {
    return;
  }

  const id = customerId ? String(customerId) : null;
  if (String(getCustomerId(cart) || "") === String(id || "")) {
    updateCustomerDropdown();
    return;
  }

  cart.customer = id;
  cart.customer_id = id;
  cart.customer_name = id ? customerDirectory.get(id)?.name || cart.customer_name || "" : "";
  markCartChanged(cart);
  selectedCustomer = id;

  updateCustomerDropdown();

  /*
   * Recalculate authoritative pricing
   * because customer groups may affect
   * pricing.
   */
  if (cart.items.length) {
    renderCart();
    await previewCurrentCart();
  }

  showNotification(id ? "Customer assigned" : "Walk-in customer selected", "success");
}

/** Show the active cart's customer (kept name for compatibility with callers). */
function updateCustomerDropdown() {
  const cart = getActiveCart();
  const label = document.getElementById("customer-selected");
  const clear = document.getElementById("customer-clear");
  if (label) label.textContent = cartCustomerLabel(cart, customerDirectory);
  clear?.classList.toggle("hidden", !getCustomerId(cart));
}

