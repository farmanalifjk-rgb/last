/** Render lucide icons inside markup injected after the page render. */
function refreshIcons() {
  try {
    createIcons({ icons });
  } catch (error) {
    console.error("ICON RENDER ERROR:", error);
  }
}

function canDiscount() {
  return hasPermission("pos.discount");
}

/** Refuse edits to a cart whose checkout is in flight or unresolved. */
function guardCartEditable(cart) {
  if (!isCartLocked(cart)) {
    return true;
  }
  showNotification(
    "This sale is waiting for its checkout result. Retry the same sale or discard it first.",
    "error",
  );
  return false;
}

/** Any cart edit: the old preview and Idempotency-Key no longer describe it. */
function markCartChanged(cart) {
  if (cart) {
    cart.checkoutIdempotencyKey = null;
    cart.preview = null;
  }
  currentPreview = null;
  paymentQuote = null;
}

function isAnyPosModalOpen() {
  const ids = ["payment-modal", "session-modal", "customer-modal", "park-modal", "parked-modal", "cash-modal"];
  if (ids.some((id) => {
    const el = document.getElementById(id);
    return el && !el.classList.contains("hidden");
  })) {
    return true;
  }
  return Boolean(document.querySelector("#ui-modal-root [role='dialog']"));
}

function getActiveCart() {
  return carts.find((cart) => cart.id === activeCartId) || null;
}

// Carts live in memory only: the sidebar's business switcher (full reload)
// asks how many hold items so it can warn before they are discarded.
window.posOpenCartCount = () => carts.filter((cart) => cart.items?.length).length;

function getProductPrice(product) {
  return (
    parseFloat(
      product.base_price ?? product.sales_price ?? product.price ?? 0,
    ) || 0
  );
}

function getProductImage(product) {
  // Only http(s) URLs may reach an <img src>. Relative media paths resolve
  // against the API origin, which differs from the page when
  // VITE_API_BASE_URL points at another host.
  return safeWebUrl(product?.image, getApiBaseUrl());
}

/*
 * Sellable stock for the location checkout will decrement. Prefer the
 * backend's available_quantity (on-hand minus active reservations, scoped to
 * the cashier session's warehouse); fall back to the legacy aggregate field.
 */
function getProductStock(product) {
  const value = product?.available_quantity ?? product?.stock_quantity ?? 0;
  const number = Number.parseFloat(value);
  return Number.isFinite(number) ? number : 0;
}

function formatStock(value) {
  return Number.isInteger(value) ? String(value) : value.toFixed(3).replace(/0+$/, "").replace(/\.$/, "");
}

function generateIdempotencyKey() {
  if (
    typeof crypto !== "undefined" &&
    typeof crypto.randomUUID === "function"
  ) {
    return crypto.randomUUID();
  }

  return `pos-${Date.now()}-${Math.random().toString(36).slice(2)}`;
}

function getCartItemsPayload(cart) {
  return cart.items.map((item) => ({
    product_id: Number(item.id),
    quantity: String(item.qty),
  }));
}

function getCustomerId(cart) {
  return cart?.customer_id || cart?.customer || null;
}

