}

/* =========================================================
   ADD / REMOVE / QUANTITY
========================================================= */

function addToCart(productId) {
  let cart = getActiveCart();

  if (!cart) {
    showNotification("Create a new order first", "error");

    return false;
  }

  if (!guardCartEditable(cart)) {
    return false;
  }

  const product = products.find(
    (item) => Number(item.id) === Number(productId),
  );

  if (!product) {
    showNotification("Product not found", "error");

    return false;
  }

  const existing = cart.items.find(
    (item) => Number(item.id) === Number(productId),
  );

  if (existing) {
    existing.qty = Number(existing.qty) + 1;
  } else {
    cart.items.push({
      id: product.id,
      name: product.name,
      price: getProductPrice(product),
      qty: 1,
      image: product.image,
      stock_quantity: getProductStock(product),
      sku: product.sku,
      barcode: product.barcode,
    });
  }

  markCartChanged(cart);

  renderCart();

  return true;
}

function increaseQty(productId) {
  const cart = getActiveCart();

  if (!cart || !guardCartEditable(cart)) {
    return;
  }

  const item = cart.items.find((row) => Number(row.id) === Number(productId));

  if (!item) {
    return;
  }

  item.qty = Number(item.qty) + 1;

  markCartChanged(cart);

  renderCart();
}

function decreaseQty(productId) {
  const cart = getActiveCart();

  if (!cart || !guardCartEditable(cart)) {
    return;
  }

  const item = cart.items.find((row) => Number(row.id) === Number(productId));

  if (!item) {
    return;
  }

  item.qty = Number(item.qty) - 1;

  if (item.qty <= 0) {
    cart.items = cart.items.filter(
      (row) => Number(row.id) !== Number(productId),
    );
  }

  markCartChanged(cart);

  renderCart();
}

function removeItem(productId) {
  const cart = getActiveCart();

  if (!cart || !guardCartEditable(cart)) {
    return;
  }

  cart.items = cart.items.filter((row) => Number(row.id) !== Number(productId));

  markCartChanged(cart);

  renderCart();
}

