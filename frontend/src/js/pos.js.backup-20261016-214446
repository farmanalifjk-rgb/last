function createOrder() {
  if (!sessionOpen) {
    showNotification("Open a cash session first", "error");

    showOpenSessionModal();
    return;
  }

  const id = Date.now() + Math.floor(Math.random() * 1000);

  const order = newCart({ id, name: nextOrderName() });

  carts.push(order);

  activeCartId = id;
  currentPreview = null;
  paymentQuote = null;

  renderTabs();
  renderCart();
  updateCustomerDropdown();
}

/** "Order N" that is not already used by an open tab. */
function nextOrderName() {
  const used = new Set(carts.map((cart) => cart.name));
  let index = carts.length + 1;
  while (used.has(`Order ${index}`)) {
    index += 1;
  }
  return `Order ${index}`;
}

function renderTabs() {
  const tabs = document.getElementById("order-tabs");

  if (!tabs) {
    return;
  }

  tabs.innerHTML = "";

  carts.forEach((order) => {
    const isActive = order.id === activeCartId;

    tabs.innerHTML += `
      <button
        onclick="switchOrder(${Number(order.id)})"
        class="
          px-4 py-2
          rounded-full
