// True when the category bar is built from product rows (catalog endpoint refused).
let categoriesFromProductRows = false;

async function loadCategories() {
  try {
    const data = await apiJson("/api/categories/");

    categories = Array.isArray(data) ? data : data.results || [];
    categoriesFromProductRows = false;

    renderCategories();
  } catch (error) {
    // The catalog category endpoint is permission-gated; a cashier may only have POS access.
    // Fall back to the categories carried by the POS product rows so filtering still works.
    console.error("LOAD CATEGORIES ERROR:", error);
    categories = categoriesFromProducts(products);
    categoriesFromProductRows = true;
    renderCategories();
  }
}

function categoriesFromProducts(rows) {
  const byId = new Map();
  for (const product of rows) {
    const id = product.category_id ?? product.category;
    if (id === null || id === undefined || id === "" || byId.has(String(id))) continue;
    byId.set(String(id), { id: Number(id), name: product.category_name || `Category #${id}` });
  }
  return [...byId.values()].sort((a, b) => a.name.localeCompare(b.name));
}

