/* =========================================================
   TOTALS
========================================================= */

function setTotalsText({ subtotal, tax, total }) {
  const subtotalEl = document.getElementById("subtotal");
  const taxEl = document.getElementById("tax");
  const totalEl = document.getElementById("total");

  if (subtotalEl) subtotalEl.innerText = subtotal;
  if (taxEl) taxEl.innerText = tax;
  if (totalEl) totalEl.innerText = total;
}

function setTotalsMessage(message) {
  const box = document.getElementById("pos-totals-error");

  if (!box) {
    return;
  }

  box.textContent = message || "";
  box.classList.toggle("hidden", !message);
}

/** Show the active cart's discount; disable it without permission or while locked. */
function syncDiscountInput(cart) {
  const input = document.getElementById("discount");

  if (!input) {
    return;
  }

  const allowed = canDiscount();
  const value = cart && allowed ? String(cart.discount ?? "0.00") : "0.00";

  if (input.value !== value) {
    input.value = value;
  }

  input.disabled = !cart || !allowed || isCartLocked(cart);
  input.title = allowed ? "" : "Your role does not allow discounts.";
}

function showPreviewTotals(data) {
  setTotalsText({
    subtotal: formatMoney(data.subtotal),
    tax: formatMoney(data.tax),
    total: formatMoney(data.total),
  });
}

/*
 * Totals panel. Tax and total ALWAYS come from the server preview
 * (/api/pos/preview/): until it answers they show "â€¦", never a guessed rate.
 */
function setCartTotals(subtotal) {
  const cart = getActiveCart();

  syncDiscountInput(cart);

  if (!cart || !cart.items.length) {
    setTotalsMessage("");
    setTotalsText({ subtotal: formatMoney(0), tax: formatMoney(0), total: formatMoney(0) });
    return;
  }

  const discountCheck = parseDiscount(cart.discount);

  if (canDiscount() && !discountCheck.ok) {
    setTotalsMessage(discountCheck.message);
  } else {
    setTotalsMessage("");
  }

  const fingerprint = cartFingerprint(cart, effectiveDiscount(cart, canDiscount()));

  if (cart.preview && cart.previewFingerprint === fingerprint) {
    showPreviewTotals(cart.preview);
    return;
  }

  setTotalsText({ subtotal: formatMoney(subtotal), tax: "â€¦", total: "â€¦" });
  schedulePreview();
}

function schedulePreview() {
  clearTimeout(previewTimer);

  previewTimer = setTimeout(() => {
    previewTimer = null;
    previewCurrentCart({ quiet: true });
  }, PREVIEW_DEBOUNCE_MS);
}

/* =========================================================
   CANONICAL PREVIEW
========================================================= */

/**
 * Ask the server for authoritative prices, discount allocation, tax and total.
 * `quiet` previews (typing, scanning) report failures inline only; explicit
 * ones (payment, checkout) also raise a notification.
 * Responses for a cart that changed meanwhile are discarded.
 */
async function previewCurrentCart({ quiet = false } = {}) {
  const cart = getActiveCart();

  if (!cart || !cart.items.length) {
    return null;
  }

  const discount = effectiveDiscount(cart, canDiscount());
  const fingerprint = cartFingerprint(cart, discount);
  const isCurrent = () =>
    getActiveCart() === cart &&
    cartFingerprint(cart, effectiveDiscount(cart, canDiscount())) === fingerprint;

  try {
    const data = await apiJson("/api/pos/preview/", {
      method: "POST",
      timeoutMs: PREVIEW_TIMEOUT_MS,
      body: JSON.stringify({
        items: getCartItemsPayload(cart),

        customer_id: getCustomerId(cart),

        discount,
      }),
    });

    if (!isCurrent()) {
      if (!quiet) {
        showNotification("The cart changed while calculating. Please try again.", "error");
      }
      return null;
    }

    cart.preview = data;
    cart.previewFingerprint = fingerprint;
    currentPreview = data;

    showPreviewTotals(data);

    if (!(canDiscount() && !parseDiscount(cart.discount).ok)) {
      setTotalsMessage("");
    }

    return data;
  } catch (error) {
    console.error("PREVIEW ERROR:", error);

    const message = error.message || "Unable to calculate order total";

    if (isCurrent()) {
      setTotalsText({
        subtotal: document.getElementById("subtotal")?.innerText || formatMoney(0),
        tax: "â€”",
        total: "â€”",
      });
      setTotalsMessage(`Total not available: ${message}`);
    }

    if (!quiet) {
      showNotification(message, "error");
    }

    return null;
  }
}

/** Store a new cart discount typed by the cashier (per cart, never global). */
function setCartDiscount(value) {
  const cart = getActiveCart();

  if (!cart) {
    syncDiscountInput(null);
    return;
  }

  if (!canDiscount()) {
    cart.discount = "0.00";
    syncDiscountInput(cart);
    return;
  }

  if (!guardCartEditable(cart)) {
    syncDiscountInput(cart);
    return;
  }

  cart.discount = String(value ?? "");
  markCartChanged(cart);
  renderCart();
}

/** Warning shown in the cart when a checkout attempt got no definitive answer. */
function pendingCheckoutBanner(cart) {
  if (cart?.pendingCheckout?.state !== "unknown") {
    return "";
  }

  return `
    <div role="alert" class="mb-3 rounded-2xl border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900">
      <p class="font-semibold">Checkout result unknown</p>
      <p class="mt-1">The server did not answer in time, so this sale may already be saved. â€œRetry same saleâ€ sends the identical request: if the sale was saved it is shown again, otherwise it is recorded once. The cart is locked until then.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" onclick="retryPendingCheckout()"
          class="h-9 rounded-xl bg-slate-900 px-4 text-sm font-semibold text-white hover:bg-slate-800">Retry same sale</button>
        <button type="button" onclick="discardPendingCheckout()"
          class="h-9 rounded-xl border border-amber-300 bg-white px-4 text-sm font-semibold text-amber-900 hover:bg-amber-100">Discard cart</button>
      </div>
    </div>`;
}

/* =========================================================
   CHECKOUT
========================================================= */

async function checkout(paymentMethod, amountReceived) {
  const cart = getActiveCart();

  if (!cart) {
    showNotification("Create an order first", "error");

    return false;
  }

  if (!cart.items.length) {
    showNotification("Add items to the cart first", "error");

    return false;
  }

  /*
   * An earlier attempt has no definitive answer: only the identical request
   * (same Idempotency-Key and body) may be sent, never a re-priced one.
   */
  if (isCartLocked(cart)) {
    return sendCheckout(cart);
  }

  const discountCheck = parseDiscount(cart.discount);

  if (canDiscount() && !discountCheck.ok) {
    showNotification(discountCheck.message, "error");

    return false;
  }

  /*
   * Get authoritative backend pricing/tax.
   */
  const preview = await previewCurrentCart();

  if (!preview) {
    return false;
  }

  const total = parseFloat(preview.total || 0);

  /*
   * The customer was told the total shown in the payment window. If the
   * server now computes a different one (price change, cart edit), stop and
   * show the new amount instead of silently charging it.
   */
  if (paymentQuote && paymentQuote.cartId === cart.id && totalsDiffer(paymentQuote.total, total)) {
    const previous = paymentQuote.total;

    setPaymentQuote(cart, preview);

    showNotification(
      `The total changed from ${formatCurrency(previous)} to ${formatCurrency(total)}. Check the amount and confirm again.`,
      "error",
    );

    return false;
  }

  const method = paymentMethod || "cash";

  const received = parseFloat(amountReceived || 0);

  if (method === "cash") {
    if (computeChange(total, received) < 0) {
      showNotification(
        `Insufficient cash. Required ${formatCurrency(total)}`,
        "error",
      );

      return false;
    }
  }

  /*
   * Card / other electronic tenders
   * should settle exactly the invoice total.
   *
   * Cash can exceed the total because
   * the backend calculates change.
   */
  const tenderAmount = method === "cash" ? received : total;

  if (!cart.checkoutIdempotencyKey) {
    cart.checkoutIdempotencyKey = generateIdempotencyKey();
  }

  /*
   * Freeze the exact request. From here until a definitive answer the cart
   * is locked, so a retry can only ever resend these same bytes.
   */
  cart.pendingCheckout = {
    state: "in_flight",
    key: cart.checkoutIdempotencyKey,
    body: JSON.stringify({
      items: getCartItemsPayload(cart),

      tenders: [
        {
          tender_type: method,
          amount: tenderAmount.toFixed(2),
        },
      ],

      customer_id: getCustomerId(cart),

      discount: parseFloat(preview.discount || 0).toFixed(2),
    }),
  };

  return sendCheckout(cart);
}

/** POST the cart's frozen checkout request and settle the outcome. */
async function sendCheckout(cart) {
  const pending = cart.pendingCheckout;

  if (!pending) {
    return false;
  }

  pending.state = "in_flight";
  syncDiscountInput(cart);

  let data;

  try {
    data = await apiJson("/api/pos/checkout/", {
      method: "POST",
      timeoutMs: CHECKOUT_TIMEOUT_MS,
      headers: {
        "Idempotency-Key": pending.key,
      },
      body: pending.body,
    });
  } catch (error) {
    console.error("CHECKOUT ERROR:", error);

    if (classifyCheckoutFailure(error) === "rejected") {
      // A definitive refusal: nothing was recorded, the cart is editable again.
      cart.pendingCheckout = null;

      if (getActiveCart() === cart) {
        renderCart();
      }

      showNotification(error.message || "Unable to complete checkout", "error");

      return false;
    }

    pending.state = "unknown";

    closePaymentModal();

    if (getActiveCart() === cart) {
      renderCart();
    }

    showNotification(
      "No answer from the server â€“ the sale may already be saved. Use â€œRetry same saleâ€; it will not be recorded twice.",
      "error",
    );

    return false;
  }

  cart.pendingCheckout = null;

  // The sale is saved. Nothing below may turn it into a reported failure.
  try {
    completeCheckout(cart, data);
  } catch (error) {
    console.error("POST-CHECKOUT UI ERROR:", error);
  }

  return true;
}

function completeCheckout(cart, data) {
  const order = data.order;

  closePaymentModal();
  paymentQuote = null;

  showNotification(
    data.idempotent_replay
      ? "Checkout restored"
      : "Order completed successfully",
    "success",
  );
  notifyFiscalStatus(data.fiscal);

  /*
   * Print the canonical receipt in a hidden frame: no new tab steals focus from
   * the barcode scanner (cashier audit G9). If the frame reports an error the
   * cashier gets the open/print fallback; "Last receipt" reprints it.
   */
  if (order?.id) {
    printReceipt(order.id, order.order_number || order.number || "");
  }

  /*
   * Reflect the sale in the loaded stock figures so the grid does not keep
   * showing pre-sale quantities (the server remains authoritative).
   */
  for (const item of cart.items) {
    const product = products.find((row) => Number(row.id) === Number(item.id));

    if (product) {
      product.available_quantity = String(getProductStock(product) - Number(item.qty || 0));
    }
  }

  renderProducts();

  /*
   * Remove the completed local cart (its discount goes with it).
   */
  carts = carts.filter((item) => item.id !== cart.id);

  if (activeCartId === cart.id) {
    activeCartId = carts.length ? carts[0].id : null;
  }

  currentPreview = getActiveCart()?.preview || null;

  renderTabs();
  renderCart();
  updateCustomerDropdown();

  /*
   * Automatically create a fresh
   * cashier order after successful sale.
   */
  if (!carts.length) {
    createOrder();
  }
}

async function retryPendingCheckout() {
  const cart = getActiveCart();

  if (!cart?.pendingCheckout || checkoutInFlight) {
    return;
  }

  checkoutInFlight = true;

  try {
    await sendCheckout(cart);
  } finally {
    checkoutInFlight = false;
  }
}

async function discardPendingCheckout() {
  const cart = getActiveCart();

  if (!cart?.pendingCheckout || checkoutInFlight) {
    return;
  }

  const confirmed = await confirmDialog({
    title: "Discard this sale?",
    message:
      "The server did not confirm whether this sale was saved. If it was, it stays recorded: check the Orders list before ringing these items up again.",
    confirmLabel: "Discard cart",
  });

  if (!confirmed) {
    return;
  }

  removeCart(cart.id);

  if (!carts.length) {
    createOrder();
  }
}

