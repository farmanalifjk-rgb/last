async function initializePOS() {
  bindReceiptFrameMessages();
  loadLastReceipt();
  const hasSession = await loadSession();

  await loadProducts();
  await loadCategories();
  await loadCustomers();

  if (hasSession) {
    /*
     * Start with one browser-local order.
     */
    carts = [];
    activeCartId = null;

    createOrder();
  } else {
    carts = [];
    activeCartId = null;

    renderTabs();
    renderCart();

    showOpenSessionModal();
  }

  refreshIcons();
}

