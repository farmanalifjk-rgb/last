/*
 * /api/pos/products/ is paginated (CustomPagination: page / page_size<=100,
 * envelope {count, page, total_pages, has_next, next, results}). Load every
 * page so cashiers can find all active products, de-duplicating by id.
 */
async function loadProducts() {
  const { products: loaded, complete, error } = await fetchAllProductPages(apiJson);

  if (complete || loaded.length || !products.length) {
    // Never replace a previously loaded full list with an empty failed load.
    products = loaded;
  }

  if (categoriesFromProductRows) {
    categories = categoriesFromProducts(products);
  }
  renderProducts();
  renderCategories();

  if (error) {
    console.error("LOAD PRODUCTS ERROR:", error);

    showNotification(
      loaded.length
        ? `Only ${loaded.length} products loaded: ${error.message || "server error"}`
        : error.message || "Unable to load products",
      "error",
    );
  }
}

/* Insert or refresh one product row returned by a server lookup. */
function upsertProduct(product) {
  if (!product || product.id === undefined || product.id === null) {
    return;
  }

  const index = products.findIndex((item) => Number(item.id) === Number(product.id));

  if (index === -1) {
    products.push(product);
  } else {
    products[index] = { ...products[index], ...product };
  }
}

