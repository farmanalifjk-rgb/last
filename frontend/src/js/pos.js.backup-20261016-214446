function removeCart(cartId) {
  carts = carts.filter((cart) => cart.id !== cartId);
  if (activeCartId === cartId) {
    activeCartId = carts.length ? carts[carts.length - 1].id : null;
  }
  currentPreview = getActiveCart()?.preview || null;
  paymentQuote = null;
  renderTabs();
  renderCart();
  updateCustomerDropdown();
}

function openParkModal() {
  const cart = getActiveCart();
  if (!cart || !cart.items.length) {
    showNotification("Add items before parking a sale", "error");
    return;
  }
  if (!guardCartEditable(cart)) {
    return;
  }
  document.getElementById("park-label").value = "";
  setFormError("park-error", "");
  setModal("park-modal", true);
}

function closeParkModal() {
  setModal("park-modal", false);
}

async function confirmPark() {
  const cart = getActiveCart();
  if (!cart || !cart.items.length) {
    closeParkModal();
    return;
  }
  const label = document.getElementById("park-label").value.trim();
  const customerId = getCustomerId(cart);
  const button = document.getElementById("park-confirm");
  button.disabled = true;
  try {
    await apiJson("/api/pos/parked-sales/", {
      method: "POST",
      body: JSON.stringify({
        label,
        customer_id: customerId ? Number(customerId) : null,
        items: getCartItemsPayload(cart),
      }),
    });
    // Parked sales store items and customer only (backend payload), so say
    // so instead of silently dropping a discount.
    const hadDiscount = effectiveDiscount(cart, canDiscount()) !== "0.00";
    removeCart(cart.id);
    closeParkModal();
    showNotification(hadDiscount ? "Sale parked. The discount is not saved with parked sales; re-enter it after resuming." : "Sale parked");
    refreshParkedCount();
  } catch (error) {
    setFormError("park-error", error.message);
  } finally {
    button.disabled = false;
  }
}

async function openParkedSalesModal() {
  setModal("parked-modal", true);
  const list = document.getElementById("parked-list");
  list.innerHTML = `<p class="py-8 text-center text-sm text-slate-400">Loadingâ€¦</p>`;
  try {
    const rows = await apiJson("/api/pos/parked-sales/");
    parkedSales = Array.isArray(rows) ? rows : [];
    updateParkedCount();
    renderParkedSales();
  } catch (error) {
    list.innerHTML = `<p class="py-8 text-center text-sm text-red-600">${escapeHtml(error.message)}</p>`;
  }
}

function closeParkedSalesModal() {
  setModal("parked-modal", false);
}

function renderParkedSales() {
  const list = document.getElementById("parked-list");
  if (!parkedSales.length) {
    list.innerHTML = `<p class="py-8 text-center text-sm text-slate-400">No parked sales in this session.</p>`;
    return;
  }
  list.innerHTML = parkedSales
    .map((sale) => {
      const count = (sale.payload?.items || []).length;
      return `
        <div class="flex items-center justify-between gap-4 p-4 border border-slate-200 rounded-xl">
          <div class="min-w-0">
            <p class="font-semibold text-slate-900 truncate">${escapeHtml(sale.label || "Untitled sale")}</p>
            <p class="text-xs text-slate-500">${escapeHtml(sale.customer_name || "Walk-in customer")} Â· ${count} item(s) Â· ${escapeHtml(formatDateTime(sale.parked_at))}</p>
          </div>
          <button onclick="resumeParkedSale(${Number(sale.id)})" class="h-9 px-4 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold shrink-0">Resume</button>
        </div>`;
    })
    .join("");
}

async function resumeParkedSale(parkedId) {
  let resumed;
  try {
    resumed = await apiJson(`/api/pos/parked-sales/${Number(parkedId)}/resume/`, { method: "POST" });
  } catch (error) {
    showNotification(error.message, "error");
    return;
  }

  const id = Date.now() + Math.floor(Math.random() * 1000);
  const customerId = resumed.customer_id ? String(resumed.customer_id) : null;
  const cart = {
    ...newCart({ id, name: nextOrderName() }),
    customer: customerId,
    customer_id: customerId,
    customer_name: resumed.customer_name || "",
  };

  const missing = [];
  for (const line of resumed.payload?.items || []) {
    const product = products.find((item) => Number(item.id) === Number(line.product_id));
    if (!product) {
      missing.push(line.product_id);
      continue;
    }
    cart.items.push({
      id: product.id,
      name: product.name,
      price: getProductPrice(product),
      qty: Number(line.quantity),
      image: product.image,
      stock_quantity: getProductStock(product),
      sku: product.sku,
      barcode: product.barcode,
    });
  }

  carts.push(cart);
  activeCartId = id;
  currentPreview = null;
  closeParkedSalesModal();
  renderTabs();
  renderCart();
  updateCustomerDropdown();
  refreshParkedCount();

  if (missing.length) {
    showNotification(`${missing.length} item(s) are no longer available and were skipped`, "error");
  } else {
    showNotification("Parked sale resumed");
  }
  if (cart.items.length) {
    await previewCurrentCart();
  }
}

/* =========================================================
   CASH IN / CASH OUT (drawer movements in the active session)
========================================================= */

function openCashModal() {
  if (!sessionOpen) {
    showNotification("Open a cash session first", "error");
    return;
  }
  document.getElementById("cash-amount").value = "";
  document.getElementById("cash-reason").value = "";
  setFormError("cash-error", "");
  setModal("cash-modal", true);
}

function closeCashModal() {
  setModal("cash-modal", false);
}

async function submitCashMovement() {
  const type = document.getElementById("cash-type").value;
  const amount = Number(document.getElementById("cash-amount").value);
  const reason = document.getElementById("cash-reason").value.trim();

  if (!(amount > 0)) {
    setFormError("cash-error", "Enter an amount greater than zero.");
    return;
  }
  if (!reason) {
    setFormError("cash-error", "Enter a reason for this movement.");
    return;
  }

  const button = document.getElementById("cash-confirm");
  button.disabled = true;
  try {
    await apiJson("/api/pos/cash-movements/", {
      method: "POST",
      body: JSON.stringify({ type, amount: amount.toFixed(2), reason }),
    });
    closeCashModal();
    showNotification(type === "in" ? "Cash added to the drawer" : "Cash removed from the drawer");
  } catch (error) {
    setFormError("cash-error", error.message);
  } finally {
    button.disabled = false;
  }
}

