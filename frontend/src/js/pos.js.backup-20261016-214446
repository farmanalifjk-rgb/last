let sessionRequestInFlight = false;

/*
 * Optional stock location for the session (POST sessions/open/ accepts
 * warehouse_id). Only shown when the tenant actually has active warehouses;
 * a failed lookup leaves the picker hidden and the session uses store stock.
 */
async function loadSessionWarehouses() {
  const wrap = document.getElementById("session-warehouse-wrap");
  const select = document.getElementById("session-warehouse");
  if (!wrap || !select) return;
  try {
    const { results } = await apiList("/api/inventory/warehouses/?page_size=200");
    const active = results.filter((row) => row && row.id != null && row.is_active !== false);
    select.querySelectorAll("option[data-warehouse]").forEach((option) => option.remove());
    for (const warehouse of active) {
      const option = document.createElement("option");
      option.value = String(warehouse.id);
      option.dataset.warehouse = "1";
      option.textContent = warehouse.code ? `${warehouse.name} (${warehouse.code})` : String(warehouse.name ?? `#${warehouse.id}`);
      select.appendChild(option);
    }
    wrap.classList.toggle("hidden", active.length === 0);
  } catch (error) {
    console.warn("Warehouse list unavailable; session will use store stock.", error);
    wrap.classList.add("hidden");
  }
}

async function openSession() {
  if (sessionRequestInFlight) return;
  const openingBalanceInput =
    document.getElementById("session-opening-cash") ||
    document.getElementById("opening_balance");
  const openingBalance = openingBalanceInput?.value ?? "0";
  if (!/^\d+(\.\d{1,2})?$/.test(String(openingBalance).trim() || "0")) {
    showNotification("Opening cash must be a non-negative amount", "error");
    return;
  }

  const warehouseId = document.getElementById("session-warehouse")?.value || "";
  const startButton = document.getElementById("session-start-button");
  sessionRequestInFlight = true;
  if (startButton) startButton.disabled = true;

  try {
    await apiJson("/api/pos/sessions/open/", {
      method: "POST",
      body: JSON.stringify({
        opening_balance: String(openingBalance).trim() || "0",
        ...(warehouseId ? { warehouse_id: Number(warehouseId) } : {}),
      }),
    });

    hideOpenSessionModal();

    carts = [];
    activeCartId = null;
    currentPreview = null;

    await loadSession();

    createOrder();

    showNotification("Cash session opened", "success");
  } catch (error) {
    console.error("OPEN SESSION ERROR:", error);

    showNotification(error.message || "Failed to open session", "error");
  } finally {
    sessionRequestInFlight = false;
    if (startButton) startButton.disabled = false;
  }
}

async function closeSession() {
  if (sessionRequestInFlight) return;

  // Local cart tabs are not persisted server-side; closing discards them.
  const openCarts = carts.filter((cart) => (cart.items || []).length > 0).length;
  const unresolved = carts.filter((cart) => isCartLocked(cart)).length;
  const unresolvedNote = unresolved
    ? ` ${unresolved} of them did not get a checkout answer and may already be saved: retry them first, or check Orders afterwards.`
    : "";
  if (openCarts && !(await confirmDialog({
    title: "Discard open carts?",
    message: `${openCarts} cart(s) still have items. Closing the session discards them (park a sale first to keep it).${unresolvedNote} Continue?`,
    confirmLabel: "Discard and continue",
  }))) {
    return;
  }

  // The canonical backend requires actual_cash (the counted drawer amount).
  const actualCash = await openModal({
    title: "Close session",
    submitLabel: "Close session",
    size: "max-w-md",
    html: `
      <label for="close-actual-cash" class="mb-2 block text-sm font-semibold text-slate-800">Counted closing cash</label>
      <input id="close-actual-cash" name="actual_cash" type="text" inputmode="decimal" autocomplete="off" required
        placeholder="0.00" class="h-11 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm focus:border-violet-400 focus:outline-none focus:ring-2 focus:ring-violet-200">
      <p class="mt-2 text-xs text-slate-500">Count the drawer and enter the amount. The server calculates the expected cash and difference.</p>`,
    onSubmit: (form) => {
      const value = String(form.elements.actual_cash?.value || "").trim();
      if (!/^\d+(\.\d{1,2})?$/.test(value)) throw new Error("Closing cash must be a non-negative amount with up to 2 decimals.");
      return value;
    },
  });

  if (typeof actualCash !== "string") {
    return;
  }

  sessionRequestInFlight = true;
  try {
    const data = await apiJson("/api/pos/sessions/close/", {
      method: "POST",
      body: JSON.stringify({
        actual_cash: actualCash.trim(),
      }),
    });

    // Report exactly what the backend computed; never substitute zeros.
    const parts = ["Session closed."];
    if (data?.expected_cash != null) parts.push(`Expected ${formatCurrency(data.expected_cash)}`);
    if (data?.session?.actual_closing_balance != null) parts.push(`counted ${formatCurrency(data.session.actual_closing_balance)}`);
    if (data?.difference != null) parts.push(`difference ${formatCurrency(data.difference)}`);
    showNotification(parts.join(" Â· "), "success");

    carts = [];
    activeCartId = null;
    currentPreview = null;

    renderTabs();
    renderCart();

    await loadSession();

    showOpenSessionModal();
  } catch (error) {
    console.error("CLOSE SESSION ERROR:", error);

    showNotification(error.message || "Failed to close session", "error");
  } finally {
    sessionRequestInFlight = false;
  }
}

/* =========================================================
   BARCODE
========================================================= */

document.addEventListener("keydown", async (event) => {
  /*
   * pos.js is loaded for the whole SPA; only treat keystrokes as scanner
   * input while the POS product grid is on screen.
   */
  if (!document.getElementById("product-grid")) {
    return;
  }

  /*
   * Don't intercept typing in normal
   * text inputs.
   */
  const target = event.target;

  const isTypingField =
    target instanceof HTMLInputElement ||
    target instanceof HTMLTextAreaElement ||
    target instanceof HTMLSelectElement;

  if (isTypingField && target.id !== "product-search") {
    return;
  }

  if (event.key === "Enter") {
    const code = barcodeBuffer.trim();
    const searchBefore = searchValueAtScanStart;
    const searchInput =
      target instanceof HTMLInputElement && target.id === "product-search" ? target : null;

    barcodeBuffer = "";
    searchValueAtScanStart = null;
    clearTimeout(barcodeTimer);

    if (!code) {
      return;
    }

    /*
     * A scan while a dialog is open (payment, customer, park...) must not
     * change the cart behind it, nor "press" the dialog's focused button.
     */
    if (isAnyPosModalOpen()) {
      event.preventDefault();
      showNotification("Close the open window before scanning.", "error");
      return;
    }

    const added = await processBarcode(code);

    /*
     * The scanner also "typed" the code into the focused search box. After a
     * successful scan put the box back as it was; after a failed one select
     * the text so the next scan replaces it instead of appending to it.
     */
    if (searchInput) {
      if (added) {
        searchInput.value = searchValueAfterScan({ before: searchBefore, current: searchInput.value, code });
        searchProducts();
      } else {
        searchInput.select();
      }
    }

    return;
  }

  if (
    event.key.length === 1 &&
    !event.ctrlKey &&
    !event.altKey &&
    !event.metaKey
  ) {
    if (!barcodeBuffer) {
      // keydown fires before the character lands in the input.
      searchValueAtScanStart =
        target instanceof HTMLInputElement && target.id === "product-search" ? target.value : null;
    }

    barcodeBuffer += event.key;

    clearTimeout(barcodeTimer);

    barcodeTimer = setTimeout(() => {
      barcodeBuffer = "";
      searchValueAtScanStart = null;
    }, 100);
  }
});

/** Look up a scanned code and add it to the active cart. Returns true when added. */
async function processBarcode(code) {
  try {
    const data = await apiJson(
      `/api/pos/products/?barcode=${encodeURIComponent(code)}`,
      { timeoutMs: LOOKUP_TIMEOUT_MS },
    );

    const rows = Array.isArray(data) ? data : data.results || [];

    const product = rows[0];

    if (!product) {
      showNotification(`No product with barcode ${code}`, "error");

      return false;
    }

    // The scanned product may be outside the currently loaded list (e.g. it
    // was created after the POS loaded); keep the server row so it can be sold.
    upsertProduct(product);

    if (!addToCart(product.id)) {
      return false;
    }

    beepSound.play().catch(() => {});

    renderProducts();

    showNotification(`${product.name} added`, "success");

    return true;
  } catch (error) {
    console.error("BARCODE ERROR:", error);

    showNotification(error.message || "Product lookup failed", "error");

    return false;
  }
}

